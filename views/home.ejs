<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Password Generator</title>
    <%- include("./header.ejs") %>
  </head>

  <body>
    <div class="container py-5">
      <h2 class="title">
        🔐 Password Generator
        <br />
        <span>Fast • Secure • Customizable</span>
      </h2>

      <div class="main-card mx-auto">
        <form
          action="/password"
          method="POST"
          class="needs-validation"
          novalidate
          id="details"
        >
          <!-- Password Length -->

          <div class="mb-4">
            <label for="passwordLength" class="form-label fw-semibold">
              📏 Password Length
            </label>

            <input
              id="passwordLength"
              class="form-control"
              type="number"
              name="pw[length]"
              min="6"
              max="100"
              value="8"
              required
            />

            <div class="invalid-feedback">Enter a value between 6 and 100.</div>
          </div>

          <!-- Numbers -->

          <div class="mb-4">
            <h5>🔢 Include Numbers?</h5>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[numbers]"
                id="numbersYes"
                value="true"
                checked
              />
              <label class="form-check-label" for="numbersYes">Yes</label>
            </div>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[numbers]"
                id="numbersNo"
                value="false"
              />
              <label class="form-check-label" for="numbersNo">No</label>
            </div>
          </div>

          <!-- Symbols -->

          <div class="mb-4">
            <h5>✨ Include Symbols?</h5>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[symbols]"
                id="symbolsYes"
                value="true"
                checked
              />
              <label class="form-check-label" for="symbolsYes">Yes</label>
            </div>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[symbols]"
                id="symbolsNo"
                value="false"
              />
              <label class="form-check-label" for="symbolsNo">No</label>
            </div>
          </div>

          <!-- Lowercase -->

          <div class="mb-4">
            <h5>🔡 Include Lowercase Letters?</h5>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[lowercase]"
                id="lowercaseYes"
                value="true"
                checked
              />
              <label class="form-check-label" for="lowercaseYes">Yes</label>
            </div>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[lowercase]"
                id="lowercaseNo"
                value="false"
              />
              <label class="form-check-label" for="lowercaseNo">No</label>
            </div>
          </div>

          <!-- Uppercase -->

          <div class="mb-4">
            <h5>🔠 Include Uppercase Letters?</h5>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[uppercase]"
                id="uppercaseYes"
                value="true"
                checked
              />
              <label class="form-check-label" for="uppercaseYes">Yes</label>
            </div>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[uppercase]"
                id="uppercaseNo"
                value="false"
              />
              <label class="form-check-label" for="uppercaseNo">No</label>
            </div>
          </div>

          <!-- Exclude Similar -->

          <div class="mb-4">
            <h5>🚫 Exclude Similar Characters?</h5>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[excludeSimilarCharacters]"
                id="similarYes"
                value="true"
              />
              <label class="form-check-label" for="similarYes">Yes</label>
            </div>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[excludeSimilarCharacters]"
                id="similarNo"
                value="false"
                checked
              />
              <label class="form-check-label" for="similarNo">No</label>
            </div>
          </div>

          <!-- Excluded Characters -->

          <div class="mb-4">
            <label for="excludeChars" class="form-label fw-semibold">
              🚷 Excluded Characters (Optional)
            </label>

            <input
              class="form-control"
              id="excludeChars"
              name="pw[exclude]"
              type="text"
              placeholder="Example: abc123"
            />
          </div>

          <!-- Strict -->

          <div class="mb-4">
            <h5>🛡 Require every selected character type?</h5>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[strict]"
                id="strictYes"
                value="true"
              />
              <label class="form-check-label" for="strictYes">Yes</label>
            </div>

            <div class="form-check form-check-inline">
              <input
                class="form-check-input"
                type="radio"
                name="pw[strict]"
                id="strictNo"
                value="false"
                checked
              />
              <label class="form-check-label" for="strictNo">No</label>
            </div>
          </div>

          <div class="text-center">
            <button class="btn btn-primary px-5" type="submit">
              🔐 Generate Password
            </button>
          </div>
        </form>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
      (() => {
        "use strict";

        document.querySelectorAll(".needs-validation").forEach((form) => {
          form.addEventListener("submit", (e) => {
            if (!form.checkValidity()) {
              e.preventDefault();
              e.stopPropagation();
            }

            form.classList.add("was-validated");
          });
        });
      })();
    </script>
  </body>
</html>
