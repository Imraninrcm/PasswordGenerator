<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Password Generated</title>
    <%- include("./header.ejs") %>
    <style>
      .custom-alert {
        position: fixed;
        top: 30px;
        right: 30px;
        background: #ffffff;
        color: #1e293b;
        border-left: 5px solid #22c55e;
        padding: 18px 24px;
        border-radius: 15px;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.12);
        display: flex;
        align-items: center;
        gap: 12px;
        animation: slide 0.4s ease;
      }

      .custom-alert i {
        color: #22c55e;
        font-size: 22px;
      }

      @keyframes slide {
        from {
          opacity: 0;
          transform: translateX(80px);
        }

        to {
          opacity: 1;
          transform: translateX(0);
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <h3 class="title">
        Your <b>Secure Password</b> <br />
        <span style="font-size: 1.2rem; font-weight: 400">
          Copy and use your new password below
        </span>
      </h3>
      <div class="main-card mx-auto">
        <div class="mb-3">
          <label for="password-text" class="form-label">
            <h5>Generated Password</h5>
          </label>
          <div class="card-text form-control" id="password-text">
            <%= password %>
          </div>
          <div class="d-flex justify-content-center mt-2">
            <button type="button" class="btn btn-primary" id="copyBtn">
              <i class="fa-regular fa-clipboard copy-icon"></i> Copy Password
            </button>
          </div>
        </div>
        <div id="btn" class="d-flex justify-content-center mt-3">
          <a href="/" id="Regenerate">
            <button class="btn btn-primary">Generate Another Password</button>
          </a>
        </div>
      </div>
      <div class="alert-container"></div>
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      crossorigin="anonymous"
    ></script>
    <script>
      // Function to copy password text to clipboard
      function copyPassword() {
        const passwordText = document
          .querySelector("#password-text")
          .innerText.trim();
        console.log(passwordText);
        navigator.clipboard.writeText(passwordText).then(
          () => {
            showAlert("Password copied to clipboard!", "success");
          },
          (err) => {
            showAlert("Failed to copy password!", "danger");
            console.error("Error copying text: ", err);
          },
        );
      }

      // Function to show attractive centered alert
      function showAlert(message, type) {
        // Remove any existing custom alert
        const oldAlert = document.querySelector(".custom-alert");
        if (oldAlert) oldAlert.remove();

        const alert = document.createElement("div");
        alert.className = "custom-alert";
        alert.innerHTML = `
          <i class="fa-solid fa-check-circle"></i>
          ${message}
        `;
        document.body.appendChild(alert);
        setTimeout(() => {
          alert.style.opacity = "0";
          setTimeout(() => alert.remove(), 400);
        }, 2000);
      }

      document
        .querySelector("#copyBtn")
        .addEventListener("click", copyPassword);
    </script>
  </body>
</html>
